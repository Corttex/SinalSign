# Configurações do Portal Sinal Sign
NEXT_PUBLIC_SITE_URL=https://sinalsign.com.br

# Banco de Dados PostgreSQL (Local ou Docker)
DATABASE_URL=postgresql://sinalsign:sinalsign_secure_pass@localhost:5432/sinalsign_db?schema=public

# Credenciais Docker PostgreSQL
POSTGRES_USER=sinalsign
POSTGRES_PASSWORD=sinalsign_secure_pass
POSTGRES_DB=sinalsign_db
